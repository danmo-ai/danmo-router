HOST=0.0.0.0
# Each split binary has its own default PORT if unset:
#   danmo-relay  → 3000
#   danmo-admin  → 3001
#   danmo-user   → 3002
#   danmo-router → 3000 (all-in-one, local only)
PORT=3000

DATABASE_URL=sqlite://data/danmo.db?mode=rwc
# Shared by all processes. Prefer a networked DB when scaling relay replicas.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEFAULT_USER_QUOTA=500000
RELAY_MAX_RETRIES=2
# Per-process safety caps for runaway clients, attacks, and retry loops.
# Not a cluster-wide quota: each danmo-relay process counts on its own.
# One account's keys share the user limits.
RELAY_USER_CONCURRENCY=4
RELAY_INSTANCE_CONCURRENCY=32
RELAY_USER_QPS=5
RELAY_INSTANCE_QPS=50
# Unsigned legacy sk- keys share this small budget until a lookup confirms the account.
RELAY_LEGACY_CONCURRENCY=4
RELAY_LEGACY_QPS=10
# Per-relay channel health (see docs/channel-health.md).
CB_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_BASE_EJECT_SECS=30
CB_MAX_EJECT_SECS=600
RL_WEIGHT_FLOOR=0.05
RL_RECOVER_SECS=60
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Base URL shown on the user portal. Include /v1. Unset keeps http://127.0.0.1:3000/v1.
# PUBLIC_RELAY_URL=https://api.example.com/v1
RUST_LOG=info
# 1 loads sample channels, users, tokens, and logs the first time the database is empty
# of that sample. Demo login: demo / demo1234. API key: sk-demo-playground.
# Upstream keys in the sample are placeholders, not live credentials.
SEED_DEMO=0
