HOST=0.0.0.0
# Each split binary has its own default PORT if unset:
#   danmo-relay  → 3000
#   danmo-admin  → 3001
#   danmo-user   → 3002
#   danmo-router → 3000 (all-in-one, local only)
PORT=3000

DATABASE_URL=sqlite://data/danmo.db?mode=rwc
# Shared by all processes. Prefer a networked DB when scaling relay replicas.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEFAULT_USER_QUOTA=500000
RELAY_MAX_RETRIES=2
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RUST_LOG=info
